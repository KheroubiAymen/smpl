<svg :width="width" :height="height" :style="{ marginLeft: svgOffsetLeft + 'px' }">
	<g id="frameLayer" class="layer"></g>
	<g id="batchLayer" class="layer"></g>
	<g id="linkLayer" class="layer"></g>
	<g id="lineLayer" class="layer"></g>
	<g id="nodeLayer" class="layer"></g>
</svg>

<div v-if="loading" class="config-loading-overlay">
  <div class="config-loading-bg"></div>
  <div class="config-loading-content">
    <div class="config-loading-mark">
      <svg viewBox="0 0 48 48" width="60" height="60" aria-hidden="true">
        <rect x="4" y="4" width="27" height="27" rx="8" fill="#0072CE"/>
        <rect x="17" y="17" width="27" height="27" rx="8" fill="#00C389" opacity="0.92"/>
      </svg>
    </div>
    <div class="config-loading-brand">SMPL <span class="config-loading-brand-sub">config</span></div>
    <div class="config-loading-tagline">Workflow builder</div>
    <div class="config-progress-bar-container">
      <div class="config-progress-bar">
        <div class="config-progress-fill" :style="{ width: loadingProgress + '%' }"></div>
      </div>
      <div class="config-progress-pct">{{ loadingProgress }}%</div>
    </div>
    <div class="config-progress-message">
      <span class="config-progress-dot"></span>
      {{ loadingMessage }}
    </div>
    <div class="config-loading-version">v{{ appVersion }}</div>
  </div>
</div>

<!-- Side bar de navigation entre workflows — remplace le dropdown, groupé par
     étude, rétractable (fermé par défaut). Le premier workflow se charge
     automatiquement, plus d'écran de sélection intermédiaire. Masquée
     pendant qu'un modal est ouvert (évite les conflits de superposition). -->
<div v-if="!formIdToEdit &amp;&amp; !loadedForms &amp;&amp; !workflowWizard &amp;&amp; !batchFormEntity" class="dd-sidebar" :class="{ 'dd-sidebar-collapsed': sidebarCollapsed }">
  <div class="dd-sidebar-header">
    <span v-if="!sidebarCollapsed" class="dd-sidebar-title">Workflows</span>
    <span v-if="!sidebarCollapsed" class="dd-sidebar-pin" :class="{ active: sidebarPinned }"
      :title="sidebarPinned ? 'Unpin sidebar' : 'Pin sidebar open'" @click="toggleSidebarPin()">📌</span>
    <span class="dd-sidebar-toggle" @click="sidebarCollapsed = !sidebarCollapsed">{{ sidebarCollapsed ? '»' : '«' }}</span>
  </div>
  <div v-if="!sidebarCollapsed" class="dd-sidebar-body">
    <div class="dd-sidebar-new" @click="openNewWorkflowForm()">+ New workflow</div>
    <div class="dd-search-input dd-sidebar-search">
      <span class="dd-search-icon">⌕</span>
      <input v-model="sidebarSearch" type="text" placeholder="Search...">
    </div>
    <div class="dd-sidebar-sort">
      <span :class="{ active: sidebarSortField === 'name' }" @click="toggleSidebarSort('name')">Name<template v-if="sidebarSortField === 'name'">{{ sidebarSortDir === 'desc' ? ' ↓' : ' ↑' }}</template></span>
      <span :class="{ active: sidebarSortField === 'date' }" @click="toggleSidebarSort('date')">Date<template v-if="sidebarSortField === 'date'">{{ sidebarSortDir === 'desc' ? ' ↓' : ' ↑' }}</template></span>
    </div>
    <!-- Seule cette liste défile — nouveau workflow/recherche/tri restent fixes en haut. -->
    <div class="dd-sidebar-list">
      <div v-if="sortedSidebarWorkflows.length === 0" class="dd-sidebar-empty">No match.</div>
      <div v-for="wf in sortedSidebarWorkflows" :key="wf.id" class="dd-sidebar-item" :class="{ active: workflow &amp;&amp; workflow.id == wf.id }"
        @click="selectWorkflow(wf.id)">
        <span class="dd-sidebar-star" :class="{ active: favoriteWorkflowIds.includes(wf.id) }"
          @click="toggleFavoriteWorkflow(wf.id, $event)">{{ favoriteWorkflowIds.includes(wf.id) ? '★' : '☆' }}</span>
        <span class="dd-sidebar-item-label">{{ wf.smpl_label }}</span>
      </div>
    </div>
  </div>
</div>

<div id="developpedBySBP">
</div>


<div id="toolbar" style="
position: fixed; 
top: 56px; 
left: 0; 
z-index: 1; 
width: 100%; 
overflow: hidden;
padding: 15px 0 15px 0;
">
</div>

<div v-if="formIdToEdit || loadedForms || stepCustomViewPopup || workflowWizard || batchFormEntity" id="cache" style="
    position: fixed;
    width:100%;
    height:100%;
    top:0;
    left:0;
	z-index: 5;
	background-color: rgba(4, 30, 66, 0.55);"></div>

<!-- Form to fill -->
<div v-if="loadedForms" style="position: fixed;
	top: 56px;
	left: 0;
	z-index: 10;
	width: 100%;
	height: calc(100% - 56px);
	background-color: #ffffff;
    box-sizing: border-box;
    border-top: 1px solid var(--dd-gray-200);
    display: flex;
    flex-direction: column;">
	<div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; box-sizing: border-box; padding: 10px;">
	<h3 v-if="forms[0].title" style="margin-bottom: 20px; margin-left: 10px; font-size: 2em;"> {{forms[0].title}} </h3>
	<EntityUpdateForm v-if="forms[0].entityToUpdate" v-for="form in forms" :key="form.id"
		:ref="`formRendering${form.id}`" :form="form.form" :entityToUpdate="form.entityToUpdate"
		:with-submit-btn="false" @form-submitted="formSubmitted(form)"/>
	<EntitiesCreatorForm v-else v-for="form in forms" :key="form.id" :ref="`formRendering${form.id}`" :form="form.form"
		:with-submit-btn="false" :defaultEntity="form.defaultEntity" @form-submitted="formSubmitted(form)"
		@entity-created="(e) => onEntityCreated(e, form)"
		@changed-value="(payload) => onCreatorFormFieldChanged(payload, form)" />

	<!-- Choix "Create new form" / "Use existing form" — CRÉATION d'une nouvelle étape -->
	<div v-if="forms[0].id === stepFormId &amp;&amp; !forms[0].entityToUpdate" style="
		background:#F9FAFB;border:1px solid #E4E7EC;border-radius:8px;padding:16px;margin:16px 10px;">
		<div style="font-size:11px;font-weight:700;letter-spacing:0.06em;color:#0D69D4;text-transform:uppercase;margin-bottom:12px;">
			Form for this step (this line only)
		</div>
		<div style="display:flex;gap:10px;margin-bottom:10px;">
			<DidataTextIconBtn text="Create new form" :color="newStepFormMode === 'create' ? 'primary' : null"
				@click="newStepFormMode = 'create'" />
			<DidataTextIconBtn text="Use existing form" :color="newStepFormMode === 'existing' ? 'primary' : null"
				@click="newStepFormMode = 'existing'; loadReusableStepForms(forms[0].pendingEventTypeId)" />
		</div>

		<div v-if="!newStepFormMode" style="font-size:13px;color:#667085;font-style:italic;">
			No form will be created for this step unless you choose one of the options above.
		</div>

		<div v-else-if="newStepFormMode === 'create'" style="font-size:13px;color:#475467;">
			A new form will be duplicated from the <strong>{{ newStepEventTypeLabel }}</strong> template when you submit.
		</div>

		<div v-else>
			<!-- Un form est choisi : ligne compacte au lieu de garder toute la liste
			     affichée — "Change" vide la sélection pour rouvrir la liste. -->
			<div v-if="newStepExistingFormId" style="
				display:flex;align-items:center;justify-content:space-between;padding:10px 12px;
				border:1px solid #0072CE;border-radius:6px;background:#EAF5FF;">
				<div>
					<div style="font-weight:600;font-size:14px;">{{ (reusableStepForms.find(f => f.id === newStepExistingFormId) || {}).name }}</div>
					<div style="font-size:12px;color:#667085;">Form #{{ newStepExistingFormId }}</div>
				</div>
				<div style="display:flex;gap:8px;">
					<DidataTextIconBtn text="View / Edit" @click="formIdToEdit = newStepExistingFormId" />
					<DidataTextIconBtn text="Change" @click="newStepExistingFormId = null" />
				</div>
			</div>

			<template v-else>
				<div v-if="!forms[0].pendingEventTypeId" style="margin-bottom:10px;padding:8px 10px;background:#FFFAEB;border-radius:6px;font-size:12px;color:#B54708;">
					Choose the event type field in the form above first to filter this list — showing all event types for now.
				</div>
				<input v-model="newStepFormSearch" type="text" placeholder="Search existing forms..."
					style="width:100%;padding:8px 10px;border:1px solid #D0D5DD;border-radius:6px;margin-bottom:10px;box-sizing:border-box;">
				<div v-if="loadingReusableForms" style="font-size:13px;color:#667085;">Loading…</div>
				<div v-else-if="filteredReusableStepForms.length === 0" style="font-size:13px;color:#667085;">No existing form found yet.</div>
				<div v-for="f in filteredReusableStepForms" :key="f.id" @click="newStepExistingFormId = f.id" style="
					display:flex;align-items:center;justify-content:space-between;padding:10px 12px;
					border:1px solid #E4E7EC;border-radius:6px;margin-bottom:6px;cursor:pointer;background:#FFF;">
					<div>
						<div style="font-weight:600;font-size:14px;">{{ f.name }}</div>
						<div style="font-size:12px;color:#667085;">Form #{{ f.id }}</div>
						<div v-if="f.workflowLabels &amp;&amp; f.workflowLabels.length" style="font-size:11.5px;color:#0D69D4;margin-top:2px;">Used in: {{ f.workflowLabels.join(', ') }}</div>
					</div>
				</div>
			</template>

			<div v-if="newStepExistingFormId" style="margin-top:10px;padding:10px 12px;background:#FFFAEB;border-radius:6px;font-size:12.5px;color:#B54708;">
				Already used elsewhere — editing it changes it everywhere it is reused.
			</div>
		</div>
	</div>

	<!-- Choix "Create new form" / "Use existing form" — ÉDITION d'une étape existante SANS form -->
	<div v-if="isEditingStepEntity &amp;&amp; !forms[0].entityToUpdate.smpl_workflow_step_form_id" style="
		background:#F9FAFB;border:1px solid #E4E7EC;border-radius:8px;padding:16px;margin:16px 10px;">
		<div style="font-size:11px;font-weight:700;letter-spacing:0.06em;color:#0D69D4;text-transform:uppercase;margin-bottom:12px;">
			Form for this step (this line only)
		</div>
		<div style="display:flex;gap:10px;margin-bottom:10px;">
			<DidataTextIconBtn text="Create new form" @click="attachNewFormToStep(forms[0].entityToUpdate)" />
			<DidataTextIconBtn text="Use existing form" :color="newStepFormMode === 'existing' ? 'primary' : null"
				@click="newStepFormMode = 'existing'" />
		</div>
		<div v-if="newStepFormMode === 'existing'">
			<input v-model="newStepFormSearch" type="text" placeholder="Search existing forms..."
				style="width:100%;padding:8px 10px;border:1px solid #D0D5DD;border-radius:6px;margin-bottom:10px;box-sizing:border-box;">
			<div v-if="loadingReusableForms" style="font-size:13px;color:#667085;">Loading…</div>
			<div v-else-if="filteredReusableStepForms.length === 0" style="font-size:13px;color:#667085;">No existing form found for this event type yet.</div>
			<div v-for="f in filteredReusableStepForms" :key="f.id" @click="attachExistingFormToStep(forms[0].entityToUpdate, f.id)" style="
				display:flex;align-items:center;justify-content:space-between;padding:10px 12px;
				border:1px solid #E4E7EC;border-radius:6px;margin-bottom:6px;cursor:pointer;background:#FFF;">
				<div>
					<div style="font-weight:600;font-size:14px;">{{ f.name }}</div>
					<div style="font-size:12px;color:#667085;">Form #{{ f.id }}</div>
					<div v-if="f.workflowLabels &amp;&amp; f.workflowLabels.length" style="font-size:11.5px;color:#0D69D4;margin-top:2px;">Used in: {{ f.workflowLabels.join(', ') }}</div>
				</div>
			</div>
		</div>
	</div>

	<!-- L'étape a déjà un form : juste un accès rapide pour le voir/éditer -->
	<div v-if="isEditingStepEntity &amp;&amp; forms[0].entityToUpdate.smpl_workflow_step_form_id" style="
		display:flex;align-items:center;justify-content:space-between;
		background:#F9FAFB;border:1px solid #E4E7EC;border-radius:8px;padding:12px 16px;margin:16px 10px;">
		<div style="font-size:13px;color:#475467;">Form #{{ forms[0].entityToUpdate.smpl_workflow_step_form_id }} is attached to this step.</div>
		<DidataTextIconBtn text="View / Edit" @click="formIdToEdit = forms[0].entityToUpdate.smpl_workflow_step_form_id" />
	</div>
	</div>

	<div class="text-right" style="flex-shrink: 0; background: #ffffff; padding: 10px; border-top: 1px solid var(--dd-gray-200); box-sizing: border-box;">
		<DidataTextIconBtn text="Close" @click="forms = []; collectionOngoing = false" />
		<DidataTextIconBtn text="Submit" :title="isValidforms ? 'Submit' : 'Validation Error'"
			:color="isValidforms ?'primary':'red'" :icon="isValidforms ? 'add' : 'warning'" @click="submit" />
	</div>
</div>

<!-- Custom view per step popup -->
<div v-if="stepCustomViewPopup" style="position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    background: #FFFFFF;
    border: 1px solid #C2C2C2;
    border-radius: 8px;
    padding: 20px;
    min-width: 340px;
    max-width: 480px;
    box-shadow: 0 4px 20px rgba(4,30,66,0.25);">
    <h3 style="margin: 0 0 6px 0; font-size: 1.1em; color: var(--dd-navy-800); font-family: 'Urbanist', sans-serif;">Custom view — step</h3>
    <p style="margin: 0 0 14px 0; font-size: 0.85em; color: #888;">{{ stepCustomViewPopup.stepLabel }}</p>
    <div style="display: flex; flex-direction: column; gap: 6px; max-height: 280px; overflow-y: auto; margin-bottom: 16px;">
        <label style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid #E4E7EC; border-radius: 6px; cursor: pointer;"
            :style="{ background: !getStep(stepCustomViewPopup.stepId) || !getStep(stepCustomViewPopup.stepId).Custom_View_ID_Step ? '#EAF5FF' : '#F9FAFB' }">
            <input type="radio"
                :checked="!getStep(stepCustomViewPopup.stepId) || !getStep(stepCustomViewPopup.stepId).Custom_View_ID_Step"
                @change="saveStepCustomView(null)">
            <span style="font-size: 13px; color: #475467;">— Default (line / global)</span>
        </label>
        <label v-for="cv in allSampleCustomViews" :key="cv.id"
            style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid #E4E7EC; border-radius: 6px; cursor: pointer;"
            :style="{ background: getStep(stepCustomViewPopup.stepId) && getStep(stepCustomViewPopup.stepId).Custom_View_ID_Step == cv.id ? '#EAF5FF' : '#F9FAFB' }">
            <input type="radio"
                :checked="getStep(stepCustomViewPopup.stepId) && getStep(stepCustomViewPopup.stepId).Custom_View_ID_Step == cv.id"
                @change="saveStepCustomView(cv.id)">
            <span style="font-size: 13px; color: #344054;">{{ cv.name }}</span>
        </label>
    </div>
    <div style="text-align: right;">
        <DidataTextIconBtn text="Close" @click="closeStepCustomViewConfig()"></DidataTextIconBtn>
    </div>
</div>

<!-- Form for this batch — le VRAI form de collecte utilisé plus tard dans
     smpl normal (smpl_workflow_step_form_id), pas le form d'édition des
     champs de l'étape/batch. Popup dédié et minimal, indépendant de
     forms[]/loadedForms. -->
<div v-if="batchFormEntity" style="position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 12px;
    padding: 20px;
    min-width: 380px;
    max-width: 520px;
    max-height: 70vh;
    overflow-y: auto;
    box-shadow: 0 4px 20px rgba(4,30,66,0.25);">
    <h3 style="margin: 0 0 4px 0; font-size: 1.1em; color: var(--dd-navy-800); font-family: 'Urbanist', sans-serif;">Form for this batch</h3>
    <p style="margin: 0 0 16px 0; font-size: 0.85em; color: #667085;">The form used to collect data for this batch in production.</p>

    <div v-if="batchFormEntity.smpl_workflow_step_form_id" style="
        display:flex;align-items:center;justify-content:space-between;
        background:#F9FAFB;border:1px solid #E4E7EC;border-radius:8px;padding:12px 16px;">
        <div style="font-size:13px;color:#475467;">Form #{{ batchFormEntity.smpl_workflow_step_form_id }} is attached to this batch.</div>
        <DidataTextIconBtn text="View / Edit" @click="formIdToEdit = batchFormEntity.smpl_workflow_step_form_id; closeBatchFormPopup()" />
    </div>

    <template v-else>
        <div style="display:flex;gap:10px;margin-bottom:12px;">
            <DidataTextIconBtn text="Create new form" @click="attachNewFormToStep(batchFormEntity).then(closeBatchFormPopup)" />
            <DidataTextIconBtn text="Use existing form" :color="newStepFormMode === 'existing' ? 'primary' : null"
                @click="newStepFormMode = 'existing'" />
        </div>
        <div v-if="newStepFormMode === 'existing'">
            <input v-model="newStepFormSearch" type="text" placeholder="Search existing forms..."
                style="width:100%;padding:8px 10px;border:1px solid #D0D5DD;border-radius:6px;margin-bottom:10px;box-sizing:border-box;">
            <div v-if="loadingReusableForms" style="font-size:13px;color:#667085;">Loading…</div>
            <div v-else-if="filteredReusableStepForms.length === 0" style="font-size:13px;color:#667085;">No existing form found for this event type yet.</div>
            <div v-for="f in filteredReusableStepForms" :key="f.id" @click="attachExistingFormToStep(batchFormEntity, f.id).then(closeBatchFormPopup)" style="
                display:flex;align-items:center;justify-content:space-between;padding:10px 12px;
                border:1px solid #E4E7EC;border-radius:6px;margin-bottom:6px;cursor:pointer;background:#FFF;">
                <div>
                    <div style="font-weight:600;font-size:14px;">{{ f.name }}</div>
                    <div style="font-size:12px;color:#667085;">Form #{{ f.id }}</div>
                    <div v-if="f.workflowLabels &amp;&amp; f.workflowLabels.length" style="font-size:11.5px;color:#0D69D4;margin-top:2px;">Used in: {{ f.workflowLabels.join(', ') }}</div>
                </div>
            </div>
        </div>
    </template>

    <div style="text-align: right; margin-top: 16px;">
        <DidataTextIconBtn text="Close" @click="closeBatchFormPopup()"></DidataTextIconBtn>
    </div>
</div>

<!-- Wizard de création de workflow : Subject -> Case -> Kit -> Collection -->
<!-- Caché (pas retiré) tant qu'un autre form (ex: Workflow settings, ouvert
     depuis l'étape Subject) est affiché par-dessus — sinon les deux modals se
     superposent au même z-index. -->
<div v-if="workflowWizard &amp;&amp; !loadedForms" style="position: fixed;
	top: 56px;
	left: 0;
	z-index: 10;
	width: 100%;
	height: calc(100% - 56px);
	background-color: #ffffff;
    box-sizing: border-box;
    border-top: 1px solid var(--dd-gray-200);
    display: flex;
    flex-direction: column;">
	<div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; box-sizing: border-box; padding: 20px;">

	<div style="display:flex;gap:8px;margin-bottom:20px;align-items:center;">
		<div style="padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;cursor:pointer;background:#F9FAFB;color:#475467;"
			@click="editWorkflowSettingsFromWizard()">
			Workflow settings
		</div>
		<div style="width:1px;height:18px;background:#E4E7EC;"></div>
		<div v-for="s in visibleWizardSteps" :key="s" style="padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;cursor:pointer;"
			:style="{ background: s === workflowWizard.step ? '#0072CE' : '#F9FAFB', color: s === workflowWizard.step ? '#FFF' : '#667085' }"
			@click="goToWizardStep(s)">
			{{ getWizardStepConfig(s).label }}
		</div>
	</div>

	<h3 style="margin-bottom:16px;">{{ getWizardStepConfig(workflowWizard.step).label }}</h3>

	<label v-if="getWizardStepConfig(workflowWizard.step).skipFieldName" style="display:flex;align-items:center;gap:8px;margin-bottom:16px;cursor:pointer;width:fit-content;">
		<input type="checkbox" v-model="workflowWizardStepEnabled">
		<span>This workflow uses {{ workflowWizard.step === 'case' ? 'cases' : 'kits' }}</span>
	</label>

	<div v-if="!getWizardStepConfig(workflowWizard.step).skipFieldName || workflowWizardStepEnabled" style="
		background:#F9FAFB;border:1px solid #E4E7EC;border-radius:8px;padding:16px;margin-bottom:20px;">
		<div style="display:flex;gap:10px;margin-bottom:10px;">
			<DidataTextIconBtn text="Create new form" :color="newWizardFormMode === 'create' ? 'primary' : null"
				@click="newWizardFormMode = 'create'" />
			<DidataTextIconBtn text="Use existing form" :color="newWizardFormMode === 'existing' ? 'primary' : null"
				@click="newWizardFormMode = 'existing'; loadReusableWizardForms(getWizardStepConfig(workflowWizard.step).fieldName)" />
		</div>

		<div v-if="!newWizardFormMode" style="font-size:13px;color:#667085;font-style:italic;">
			Choose an option above to continue.
		</div>

		<div v-else-if="newWizardFormMode === 'create'" style="font-size:13px;color:#475467;">
			A new form will be duplicated from the <strong>{{ getWizardStepConfig(workflowWizard.step).label }}</strong> template.
		</div>

		<div v-else>
			<!-- Un form est choisi : ligne compacte au lieu de garder toute la liste
			     affichée — "Change" vide la sélection pour rouvrir la liste. -->
			<div v-if="newWizardExistingFormId" style="
				display:flex;align-items:center;justify-content:space-between;padding:10px 12px;
				border:1px solid #0072CE;border-radius:6px;background:#EAF5FF;">
				<div>
					<div style="font-weight:600;font-size:14px;">{{ (reusableWizardForms.find(f => f.id === newWizardExistingFormId) || {}).name }}</div>
					<div style="font-size:12px;color:#667085;">Form #{{ newWizardExistingFormId }}</div>
				</div>
				<div style="display:flex;gap:8px;">
					<DidataTextIconBtn text="View / Edit" @click="formIdToEdit = newWizardExistingFormId" />
					<DidataTextIconBtn text="Change" @click="newWizardExistingFormId = null" />
				</div>
			</div>

			<template v-else>
				<input v-model="newWizardFormSearch" type="text" placeholder="Search existing forms..."
					style="width:100%;padding:8px 10px;border:1px solid #D0D5DD;border-radius:6px;margin-bottom:10px;box-sizing:border-box;">
				<div v-if="loadingReusableWizardForms" style="font-size:13px;color:#667085;">Loading…</div>
				<div v-else-if="filteredReusableWizardForms.length === 0" style="font-size:13px;color:#667085;">No existing form found yet.</div>
				<div v-for="f in filteredReusableWizardForms" :key="f.id" @click="newWizardExistingFormId = f.id" style="
					display:flex;align-items:center;justify-content:space-between;padding:10px 12px;
